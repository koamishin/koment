{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "github": {
    "silent": true
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/en",
      "permanent": false
    }
  ],
  "services": {
    "auth-proxy": {
      "root": "apps/auth-proxy",
      "framework": "nitro"
    },
    "nextjs": {
      "root": "apps/nextjs",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "auth-proxy",
          "format": "url",
          "env": "AUTH_PROXY_URL"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "nextjs"
      }
    }
  ]
}
